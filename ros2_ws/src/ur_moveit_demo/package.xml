  <version>0.0.1</version>
  <description>Teaching demo: MoveIt path planning with obstacle avoidance for the UR3e.</description>
  <maintainer email="220usamaahmed@gmail.com">Usama Ahmed Siddiquie</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
